---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardPair from '../components/CardPair.astro';
import Pagination from '../components/Pagination.astro';
import Sheet from '../components/Sheet.astro';
import Switch from '../components/Switch.astro';
import { loadGlobal, loadPage, loadData } from '../lib/content';
import type { CardSet } from '../lib/content';

const global = loadGlobal();
const { meta, content } = loadPage('home');
const c = content as {
  word_match: string;
  views_label: string;
  view_browse: string;
  view_sheets: string;
  print: string;
  previous: string;
  next: string;
  counter: string;
  keys_hint: string;
  print_note: string;
};

const set = loadData<CardSet>('cards');
const { labels } = set;
const total = set.cards.length;

const perSheet = 8;
const sheets = Array.from({ length: Math.ceil(total / perSheet) }, (_, n) => ({
  first: n * perSheet + 1,
  cards: set.cards.slice(n * perSheet, (n + 1) * perSheet),
}));

const jsonLD = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: global.name,
  description: global.description,
  url: global.url,
};
---

<BaseLayout
  title={meta.title ?? undefined}
  description={meta.description}
  ogImage={meta.og_image}
  jsonLD={jsonLD}
>

  <Fragment slot="header-meta">
    <span>{set.subject}</span>
  </Fragment>

  <Fragment slot="header-tools">
    <div class="btn-group" role="group" aria-label={c.views_label}>
      <button
        class="btn"
        :class="{ 'is-active': $store.frasi.view === 'browse' }"
        @click="$store.frasi.view = 'browse'"
      >{c.view_browse}</button>
      <button
        class="btn"
        :class="{ 'is-active': $store.frasi.view === 'sheets' }"
        @click="$store.frasi.view = 'sheets'"
      >{c.view_sheets}</button>
    </div>
    <button class="btn btn-primary" @click="$store.frasi.print()">{c.print}</button>
  </Fragment>

  <h1 class="sr-only">{set.subject}, {set.name}</h1>

  <section
    class="browse"
    data-noprint
    x-init={`$store.frasi.setup(${total})`}
    x-show="$store.frasi.view === 'browse'"
    @keydown.window.left="$store.frasi.view === 'browse' && $store.frasi.prev()"
    @keydown.window.right="$store.frasi.view === 'browse' && $store.frasi.next()"
  >
    <div class="panel">
      <div class="stage">
        {set.cards.map((card, k) => (
          <div x-show={`$store.frasi.i === ${k}`} x-cloak={k > 0}>
            <CardPair card={card} number={k + 1} labels={labels} shadow />
          </div>
        ))}
      </div>

      <Pagination total={total} previous={c.previous} next={c.next} counter={c.counter} hint={c.keys_hint}>
        <Switch modelField="$store.frasi.wordMatch" label={c.word_match} />
      </Pagination>
    </div>
  </section>

  <section class="sheets" x-show="$store.frasi.view === 'sheets'" x-cloak>
    <p class="sheets-note" data-noprint>{c.print_note}</p>
    <div class="sheets-list">
      {sheets.map(({ first, cards }) => <Sheet first={first} cards={cards} set={set} />)}
    </div>
  </section>

</BaseLayout>

<style lang="scss">
  @use '../styles/breakpoints' as *;

  .browse {
    padding: var(--page-padding);
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 45rem;
    padding: 1.25rem;
    background-color: var(--parchment);
  }

  .sheets-note {
    padding: 0.75rem var(--page-padding);
    border-bottom: 0.0625rem solid var(--persian);
    background-color: var(--parchment);
    font-size: var(--text-xs);
  }

  .sheets-list {
    display: flex;
    flex-direction: column;
    gap: var(--page-padding);
    padding: var(--page-padding);
    overflow-x: auto;
  }

  @media print {
    .sheets {
      display: block !important;
    }

    .sheets-list {
      display: block;
      padding: 0;
      overflow: visible;
    }
  }

  @include small {
    .browse,
    .panel {
      padding: 1rem;
    }
  }
</style>
