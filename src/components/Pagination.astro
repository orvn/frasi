---
interface Props {
  total: number;
  previous: string;
  next: string;
  /** Counter text with {n} and {total} placeholders, e.g. "Card {n} of {total}" */
  counter: string;
  hint?: string;
}

const { total, previous, next, counter, hint } = Astro.props;

const [counterStart = '', counterRest = ''] = counter.split('{n}');
const counterEnd = counterRest.replace('{total}', String(total));
---

<div class="pagination">
  <div class="controls">
    <button class="btn btn-outline arrow" aria-label={previous} @click="$store.frasi.prev()">←</button>
    <button class="btn btn-primary arrow" aria-label={next} @click="$store.frasi.next()">→</button>
    <span>{counterStart}<span x-text="$store.frasi.i + 1">1</span>{counterEnd}</span>
    <div class="tools">
      {hint && <span class="hint">{hint}</span>}
      <slot />
    </div>
  </div>

  <div class="chips">
    {Array.from({ length: total }, (_, k) => (
      <button
        class="chip"
        :class={`{ 'is-active': $store.frasi.i === ${k} }`}
        @click={`$store.frasi.go(${k})`}
      >{k + 1}</button>
    ))}
  </div>
</div>

<style>
  .pagination {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--text-xs);
  }

  .arrow {
    width: 2.75rem;
    height: 2.25rem;
    padding: 0;
    font-size: var(--text-sm);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-left: auto;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .chip {
    flex: 0 0 2.125rem;
    height: 1.875rem;
    border: 0.0625rem solid var(--persian);
    background-color: transparent;
    color: var(--persian);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .chip:hover {
    background-color: var(--tint);
  }

  .chip.is-active {
    background-color: var(--persian);
    color: var(--parchment);
  }
</style>
