<footer class="site-footer" role="contentinfo" data-noprint>
  <div class="footer-inner">
    <nav class="footer-nav" aria-label="Footer navigation">
      <ul role="list">
        <li><a href="/privacy">Privacy</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 0.0625rem solid var(--persian);
    background-color: var(--parchment);
    padding: 1.25rem var(--page-padding);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-nav ul {
    display: flex;
    gap: 1.25rem;
  }

  .footer-nav a {
    font-size: var(--text-xs);
    color: var(--persian);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-nav a:hover {
    color: var(--koamaru);
  }
</style>
