---
---

<footer class="site-footer" role="contentinfo" data-noprint>
  <div class="footer-inner">
    <nav class="footer-nav" aria-label="Footer navigation">
      <ul role="list">
        <li><a href="/privacy">Privacy</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding: 1rem var(--page-padding);
    border-top: 0.0625rem solid var(--persian);
    background-color: var(--parchment);
    /* Same 2px ink checkerboard as the card shadows */
    background-image: repeating-conic-gradient(color-mix(in srgb, var(--persian) 55%, transparent) 0 25%, transparent 0 50%);
    background-size: 0.25rem 0.25rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-nav ul {
    display: flex;
    gap: 0.5rem;
  }

  /* Each link is a solid cutout in the dither, inverting on hover */
  .footer-nav a {
    display: inline-block;
    padding: 0.4375rem 0.875rem;
    background-color: var(--parchment);
    color: var(--persian);
    font-size: var(--text-xs);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 200ms ease, color 200ms ease;
  }

  .footer-nav a:hover {
    background-color: var(--persian);
    color: var(--parchment);
  }
</style>
