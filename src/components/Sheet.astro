---
import CardPair from './CardPair.astro';
import type { Card as CardData, CardSet } from '../lib/content';

interface Props {
  cards: CardData[];
  /** Number printed on the first card of this sheet */
  first: number;
  set: CardSet;
}

const { cards, first, set } = Astro.props;
const { cream_print, cut_guides } = set.settings;
---

<div class:list={['sheet', 'grid-x', { 'is-cream': cream_print, 'has-guides': cut_guides }]}>
  {cards.map((card, k) => (
    <div class="slot cell small-6">
      <CardPair card={card} number={first + k} labels={set.labels} />
    </div>
  ))}
</div>

<style>
  /* US Letter, 0.25in margin leaves exactly 2 × 4in by 4 × 2.625in */
  .sheet {
    --card-pad: 3.4cqw;
    --card-paper: var(--pampas);
    --pair-gap: 0.5rem;
    flex: none;
    align-content: flex-start;
    width: 8.5in;
    height: 11in;
    padding: 0.25in;
    background-color: var(--pampas);
    outline: 0.09375rem solid var(--persian);
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .sheet.is-cream {
    --card-paper: var(--spanish-quarter);
  }

  .slot {
    position: relative;
    height: 25%;
  }

  /* Drawn as an overlay so it stays above the card paper, straddling the
     slot edge so neighbouring slots share one line */
  .sheet.has-guides .slot::after {
    content: '';
    position: absolute;
    inset: -0.03125rem;
    z-index: 1;
    border: 0.0625rem dashed var(--cut-guide);
    pointer-events: none;
  }

  @media print {
    /* Pure white so printers lay down no toner on the page background */
    .sheet {
      background-color: white;
      outline: none;
      break-after: page;
    }

    .sheet:not(.is-cream) {
      --card-paper: white;
    }
  }
</style>
