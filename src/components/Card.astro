---
import { segment } from '../lib/cards';

interface Props {
  it: string;
  en: string;
  number?: number;
  labels: { en: string; it: string };
  shadow?: boolean;
}

const { it, en, number, labels, shadow = false } = Astro.props;

const rows = [
  { lang: 'it', label: labels.it, text: it },
  { lang: 'en', label: labels.en, text: en },
];
---

<div class:list={['flashcard', { 'has-shadow': shadow }]} :class="{ 'is-plain': !$store.frasi.wordMatch }">
  <div class="flashcard-face">
    <div class="flashcard-frame">
      {rows.map(({ lang, label, text }) => (
        <div class="flashcard-row" lang={lang}>
          <div class="flashcard-label">{label}</div>
          <div class="flashcard-text"><span>{segment(text).map((s) => s.match ? <span data-match={s.match}>{s.text}</span> : s.text)}</span></div>
        </div>
      ))}
    </div>
    {number && <div class="flashcard-number">№ {number}</div>}
  </div>
</div>

<style>
  /* Container query units size everything from the card width, so the same
     face works at 720px on screen and 4in on paper */
  .flashcard {
    position: relative;
    z-index: 0;
    flex: 1 1 0;
    min-height: 0;
    width: 100%;
    container-type: inline-size;
  }

  .flashcard-face {
    position: relative;
    height: 100%;
    padding: var(--card-pad, 3cqw);
    background-color: var(--card-paper, var(--spanish-quarter));
    color: var(--persian);
    font-family: var(--font-sans);
    line-height: 1.1;
    overflow: hidden;
  }

  /* Dithered drop shadow, a 2px checkerboard of ink offset behind the paper */
  .has-shadow::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    transform: translate(0.375rem, 0.375rem);
    background-image: repeating-conic-gradient(var(--persian) 0 25%, transparent 0 50%);
    background-size: 0.25rem 0.25rem;
    opacity: 0.55;
  }

  .flashcard-frame {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 0.09375rem solid var(--persian);
  }

  .flashcard-row {
    display: flex;
    flex: 1 1 0;
    min-height: 0;
  }

  .flashcard-row + .flashcard-row {
    border-top: 0.0625rem solid var(--persian);
  }

  .flashcard-label {
    display: flex;
    flex: 0 0 20cqw;
    align-items: center;
    justify-content: center;
    border-right: 0.0625rem solid var(--persian);
    font-size: 3.4cqw;
  }

  .flashcard-row[lang='it'] .flashcard-label {
    font-size: 4.2cqw;
    font-weight: 500;
  }

  .flashcard-text {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    align-items: center;
    padding: 0 4cqw 0 2.6cqw;
    font-size: 4.1cqw;
  }

  .flashcard-row[lang='it'] .flashcard-text {
    font-size: 4.8cqw;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .flashcard-number {
    position: absolute;
    top: calc(var(--card-pad, 3cqw) + 1cqw);
    right: calc(var(--card-pad, 3cqw) + 1.4cqw);
    font-size: 2.6cqw;
  }

  [data-match='1'] { color: var(--match-1); }
  [data-match='2'] { color: var(--match-2); }
  [data-match='3'] { color: var(--match-3); }
  [data-match='4'] { color: var(--match-4); }
  [data-match='5'] { color: var(--match-5); }

  .is-plain [data-match] {
    color: inherit;
  }
</style>
