---
import { loadGlobal } from '../lib/content';

const { name } = loadGlobal();
---

<header class="site-header" role="banner" data-noprint>
  <div class="header-brand">
    <a href="/" class="site-logo" aria-label={`${name} — go to homepage`}>{name}</a>
    <div class="header-meta"><slot name="meta" /></div>
  </div>
  <slot name="tools" />
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem 1.5rem;
    padding: 1.25rem var(--page-padding);
    border-bottom: 0.09375rem solid var(--persian);
    background-color: var(--parchment);
  }

  .header-brand {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.875rem;
    margin-right: auto;
  }

  .site-logo {
    font-family: var(--font-serif);
    font-size: 1.625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--persian);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .site-logo:hover {
    color: var(--koamaru);
  }

  .header-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.125rem;
    font-size: 0.9375rem;
  }

  .header-meta:empty {
    display: none;
  }
</style>
