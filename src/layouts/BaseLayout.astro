---
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { backdrops } from '../lib/backdrops';
import '../styles/global.scss';

interface Props {
  /** Page-specific title. Omit on the home page to render just the site name. */
  title?: string;
  description?: string;
  ogImage?: string;
  /** Prevents indexing — use on 404, thank-you pages, etc. */
  noindex?: boolean;
  /**
   * JSON-LD structured data object. Serialised into a <script type="application/ld+json">.
   * Should be developer-supplied data only — never pass raw user input here.
   */
  jsonLD?: Record<string, unknown>;
}

const {
  title,
  description,
  ogImage,
  noindex = false,
  jsonLD,
} = Astro.props;

// Build the canonical URL. Requires `site` to be set in astro.config.mjs.
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;

// Server renders the first backdrop, the head script below swaps in a random one before paint
const backdropData = backdrops.map(({ name, image }) => ({ name, src: image.src }));
const [defaultBackdrop] = backdropData;

---

<!doctype html>
<html lang="en" data-backdrop={defaultBackdrop.name} style={`--bg-image: url(${defaultBackdrop.src})`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      noindex={noindex}
      canonicalURL={canonicalURL}
    />

    <!-- JSON-LD structured data -->
    {jsonLD && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />
    )}

    <!-- Client-side routing with animated page transitions -->
    <ClientRouter />

    <!-- One backdrop per visit, kept across client-side navigations since the swap resets <html> attributes -->
    <script is:inline define:vars={{ backdrops: backdropData }}>
      if (!window.frasiBackdrop) {
        window.frasiBackdrop = backdrops[Math.floor(Math.random() * backdrops.length)];
        document.addEventListener('astro:after-swap', applyBackdrop);
      }
      applyBackdrop();

      function applyBackdrop() {
        const { name, src } = window.frasiBackdrop;
        document.documentElement.dataset.backdrop = name;
        document.documentElement.style.setProperty('--bg-image', `url(${src})`);
      }
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body x-data>
    <div class="backdrop" aria-hidden="true"></div>

    <!-- Skip-to-content — first focusable element, visible on keyboard focus -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Header>
      <slot name="header-meta" slot="meta" />
      <slot name="header-tools" slot="tools" />
    </Header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <script>
      document.addEventListener("click", (e) => {
        if (window.matchMedia("(hover: hover)").matches) return;

        const target = e.target as HTMLElement;
        const tooltip = target.closest(".tooltip-soon")
          || target.querySelector(":scope > .tooltip-soon")
          || (target.parentElement?.querySelector(":scope > .tooltip-soon"));

        document.querySelectorAll(".tooltip-soon.is-visible").forEach((el) => {
          if (el !== tooltip) el.classList.remove("is-visible");
        });

        if (tooltip) {
          tooltip.classList.toggle("is-visible");
        }
      });
    </script>
  </body>
</html>
